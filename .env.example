# TMDB — https://www.themoviedb.org/settings/api
# Required for the full ~100-poster wall (top_rated / discover).
# Leave empty to use a small HEAD-verified demo seed (~16 films).
# Restart the API after setting this key.
TMDB_API_KEY=

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Web — points at API (or use Vite /api proxy with VITE_API_URL=/api)
VITE_API_URL=http://localhost:3001
